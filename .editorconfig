root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python (matches ruff's line-length = 120 in apps/backend/pyproject.toml)
[*.py]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Dockerfile*]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
