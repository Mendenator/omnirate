# Anything other than "dev" requires real JWT/РД secrets and turns off the phone+OTP login
# (POST /api/v1/auth/otp/verify returns 404), since it doesn't validate codes yet.
OMNIRATE_ENV=dev
OMNIRATE_DATABASE_URL=postgresql+asyncpg://omnirate:omnirate@localhost:5432/omnirate
# DuckDB's postgres_scanner wants a libpq DSN, not SQLAlchemy's "+asyncpg" one.
OMNIRATE_DATABASE_URL_PSYCOPG=postgresql://omnirate:omnirate@localhost:5432/omnirate
OMNIRATE_REDIS_URL=redis://localhost:6379/0
OMNIRATE_OPENSEARCH_URL=http://localhost:9200

OMNIRATE_JWT_SECRET=change-me
OMNIRATE_JWT_ALGORITHM=HS256
OMNIRATE_JWT_ACCESS_TTL_SECONDS=900
OMNIRATE_RD_HMAC_SECRET=change-me

# ДАН OAuth2+PKCE — dev defaults point at the local mock provider.
# Production values require a signed ДАН agreement (see docs/PROGRESS.md).
OMNIRATE_DAN_USE_MOCK=true
OMNIRATE_DAN_CLIENT_ID=omnirate-dev
OMNIRATE_DAN_AUTHORIZE_URL=http://localhost:8080/mock-dan/authorize
OMNIRATE_DAN_TOKEN_URL=http://localhost:8080/mock-dan/token

# e-barimt QR verification — dev default points at the local mock provider.
# Production values require a tax-authority API agreement (see docs/PROGRESS.md).
OMNIRATE_E_BARIMT_USE_MOCK=true
OMNIRATE_E_BARIMT_VERIFY_URL=http://localhost:8080/mock-e-barimt/verify
OMNIRATE_E_BARIMT_MAX_RECEIPT_AGE_DAYS=90

OMNIRATE_UPLOADS_BUCKET=omnirate-dev-uploads
OMNIRATE_UPLOADS_MAX_BYTES=10485760

# Ed25519 seed (base64, 32 bytes) for hospital-visit QR signing. The value
# below is a fixed dev placeholder for reproducible local runs — NOT secret.
# Generate a real one for prod with Ed25519PrivateKey.generate().
OMNIRATE_HOSPITAL_QR_ED25519_SEED_B64=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
OMNIRATE_HOSPITAL_QR_TTL_HOURS=72

# LLM moderation fallback. Unset in dev — see app/ml/llm_moderation.py.
OMNIRATE_LLM_MODERATION_API_URL=
OMNIRATE_LLM_MONTHLY_BUDGET_USD=500.0

OMNIRATE_ANALYTICS_BUCKET=omnirate-dev-analytics

# No specific government attendance-data API identified yet (SOW dependency).
OMNIRATE_ATTENDANCE_SOURCE_URL=
OMNIRATE_TAKEDOWN_DEFAULT_SLA_HOURS=72
OMNIRATE_LAW_ENFORCEMENT_SLA_HOURS=4

OMNIRATE_RATE_LIMIT_DEFAULT_PER_MINUTE=120

# apps/web calls the API via Next.js's same-origin rewrite proxy (no CORS
# needed), but apps/mobile's Expo web target calls it cross-origin directly.
OMNIRATE_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

OMNIRATE_OTEL_EXPORTER_ENDPOINT=
OMNIRATE_SENTRY_DSN=
